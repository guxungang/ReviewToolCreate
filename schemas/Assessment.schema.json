{
  "$defs": {
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "title": "Component",
          "type": "string"
        },
        "component_version": {
          "title": "Component Version",
          "type": "string"
        },
        "actor_type": {
          "enum": [
            "program",
            "model",
            "human"
          ],
          "title": "Actor Type",
          "type": "string"
        },
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        }
      },
      "required": [
        "component",
        "component_version",
        "actor_type",
        "actor_id"
      ],
      "title": "Producer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "producer": {
