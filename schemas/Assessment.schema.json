      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "scope_checked": {
      "title": "Scope Checked",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "record_id",
    "created_at",
    "producer",
    "workspace_id",
    "paper_id",
    "paper_version_id",
    "run_id",
    "assessment_id",
    "claim_id",
    "check_type",
    "outcome",
    "evidence_ids",
    "scope_checked",
    "limitations"
  ],
  "title": "Assessment",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
