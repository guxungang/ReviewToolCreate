    },
    "validity": {
      "default": "current",
      "enum": [
        "current",
        "stale",
        "corrupt"
      ],
      "title": "Validity",
      "type": "string"
    },
    "workspace_id": {
      "title": "Workspace Id",
      "type": "string"
    },
    "paper_id": {
      "title": "Paper Id",
      "type": "string"
    },
    "paper_version_id": {
      "title": "Paper Version Id",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Run Id"
    },
    "assessment_id": {
      "title": "Assessment Id",
      "type": "string"
    },
    "claim_id": {
      "title": "Claim Id",
      "type": "string"
    },
    "check_type": {
      "title": "Check Type",
      "type": "string"
    },
