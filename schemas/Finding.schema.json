{
  "$defs": {
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "title": "Component",
          "type": "string"
        },
        "component_version": {
          "title": "Component Version",
          "type": "string"
        },
        "actor_type": {
          "enum": [
            "program",
            "model",
            "human"
          ],
          "title": "Actor Type",
          "type": "string"
        },
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        }
      },
      "required": [
        "component",
        "component_version",
        "actor_type",
        "actor_id"
      ],
      "title": "Producer",
      "type": "object"
    },
    "ReportEligibility": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "enum": [
            "author_private",
            "reviewer_private",
            "authors",
            "editor",
            "public"
          ],
          "title": "Audience",
          "type": "string"
        },
        "admitted": {
          "title": "Admitted",
          "type": "boolean"
        },
        "category": {
          "enum": [
            "strength",
            "confirmed_concern",
            "question",
            "excluded"
          ],
          "title": "Category",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "checked_at": {
          "title": "Checked At",
          "type": "string"
        }
      },
      "required": [
        "audience",
        "admitted",
        "category",
        "reason_codes",
        "checked_at"
      ],
      "title": "ReportEligibility",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "validity": {
      "default": "current",
      "enum": [
        "current",
        "stale",
        "corrupt"
      ],
      "title": "Validity",
      "type": "string"
    },
    "workspace_id": {
      "title": "Workspace Id",
      "type": "string"
    },
    "paper_id": {
      "title": "Paper Id",
      "type": "string"
    },
    "paper_version_id": {
      "title": "Paper Version Id",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Run Id"
    },
    "finding_id": {
      "title": "Finding Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "strength",
        "concern",
        "clarification"
      ],
      "title": "Kind",
      "type": "string"
    },
    "proposition": {
      "minLength": 1,
      "title": "Proposition",
      "type": "string"
    },
    "claim_ids": {
      "items": {
        "type": "string"
      },
      "title": "Claim Ids",
      "type": "array"
    },
    "hypothesis_ids": {
      "items": {
        "type": "string"
      },
      "title": "Hypothesis Ids",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "disposition": {
      "enum": [
        "candidate",
        "confirmed",
        "refuted",
        "unresolved",
        "dismissed"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "impact": {
      "enum": [
        "critical",
        "major",
        "minor",
        "informational",
        "not_assessed"
      ],
      "title": "Impact",
      "type": "string"
    },
    "potential_impact": {
      "enum": [
        "critical",
        "major",
        "minor",
        "informational",
        "not_assessed"
      ],
      "title": "Potential Impact",
      "type": "string"
    },
    "impact_rationale": {
      "title": "Impact Rationale",
      "type": "string"
    },
    "confidence_basis": {
      "title": "Confidence Basis",
      "type": "string"
    },
    "verification_ids": {
      "items": {
        "type": "string"
      },
      "title": "Verification Ids",
      "type": "array"
    },
    "duplicate_of": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duplicate Of"
    },
    "recommended_action": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recommended Action"
    },
    "report_eligibility": {
      "items": {
        "$ref": "#/$defs/ReportEligibility"
      },
      "title": "Report Eligibility",
      "type": "array"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    }
  },
  "required": [
    "record_id",
    "created_at",
    "producer",
    "workspace_id",
    "paper_id",
    "paper_version_id",
    "run_id",
    "finding_id",
    "kind",
    "proposition",
    "claim_ids",
    "hypothesis_ids",
    "evidence_ids",
    "disposition",
    "impact",
    "potential_impact",
    "impact_rationale",
    "confidence_basis",
    "verification_ids"
  ],
  "title": "Finding",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}