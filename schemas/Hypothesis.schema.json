{
  "$defs": {
    "ArtifactLocator": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "artifact",
          "default": "artifact",
          "title": "Type",
          "type": "string"
        },
        "artifact_sha256": {
          "title": "Artifact Sha256",
          "type": "string"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        }
      },
      "required": [
        "artifact_sha256",
        "json_pointer"
      ],
      "title": "ArtifactLocator",
      "type": "object"
    },
    "CodeLocator": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "code",
          "default": "code",
          "title": "Type",
          "type": "string"
        },
        "repo_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Repo Commit"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "snippet_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Snippet Sha256"
        }
      },
      "required": [
        "repo_commit",
        "relative_path",
        "line_start",
        "line_end",
        "snippet_sha256"
      ],
      "title": "CodeLocator",
      "type": "object"
    },
    "DocumentLocator": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "document",
          "default": "document",
          "title": "Type",
          "type": "string"
        },
        "block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Block Id"
        },
        "page_index": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Index"
        },
        "page_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Label"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "text_span": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Span"
        },
        "match_status": {
          "enum": [
            "exact",
            "fuzzy",
            "ambiguous",
            "unresolved"
          ],
          "title": "Match Status",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "match_status"
      ],
      "title": "DocumentLocator",
      "type": "object"
    },
    "ExternalLocator": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "external",
          "default": "external",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version Id"
        },
        "section_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Section Hint"
        },
        "access_level": {
          "enum": [
            "metadata",
            "abstract",
            "partial_fulltext",
            "fulltext",
            "supplied_primary",
            "local_computation"
          ],
          "title": "Access Level",
          "type": "string"
        }
      },
      "required": [
        "url",
        "source_id",
        "version_id",
        "section_hint",
        "access_level"
      ],
      "title": "ExternalLocator",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "title": "Component",
          "type": "string"
        },
        "component_version": {
          "title": "Component Version",
          "type": "string"
        },
        "actor_type": {
          "enum": [
            "program",
            "model",
            "human"
          ],
          "title": "Actor Type",
          "type": "string"
        },
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        }
      },
      "required": [
        "component",
        "component_version",
        "actor_type",
        "actor_id"
      ],
      "title": "Producer",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "artifact": "#/$defs/ArtifactLocator",
              "code": "#/$defs/CodeLocator",
              "document": "#/$defs/DocumentLocator",
              "external": "#/$defs/ExternalLocator"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/DocumentLocator"
            },
            {
              "$ref": "#/$defs/CodeLocator"
            },
            {
              "$ref": "#/$defs/ExternalLocator"
            },
            {
              "$ref": "#/$defs/ArtifactLocator"
            }
          ],
          "title": "Locator"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quote"
        }
      },
      "required": [
        "artifact_id",
        "locator",
        "quote"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "validity": {
      "default": "current",
      "enum": [
        "current",
        "stale",
        "corrupt"
      ],
      "title": "Validity",
      "type": "string"
    },
    "workspace_id": {
      "title": "Workspace Id",
      "type": "string"
    },
    "paper_id": {
      "title": "Paper Id",
      "type": "string"
    },
    "paper_version_id": {
      "title": "Paper Version Id",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Run Id"
    },
    "hypothesis_id": {
      "title": "Hypothesis Id",
      "type": "string"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "motivation": {
      "minLength": 1,
      "title": "Motivation",
      "type": "string"
    },
    "related_claim_ids": {
      "items": {
        "type": "string"
      },
      "title": "Related Claim Ids",
      "type": "array"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Source Refs",
      "type": "array"
    }
  },
  "required": [
    "record_id",
    "created_at",
    "producer",
    "workspace_id",
    "paper_id",
    "paper_version_id",
    "run_id",
    "hypothesis_id",
    "question",
    "motivation",
    "related_claim_ids",
    "source_refs"
  ],
  "title": "Hypothesis",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}