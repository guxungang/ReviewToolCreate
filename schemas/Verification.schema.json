{
  "$defs": {
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "title": "Component",
          "type": "string"
        },
        "component_version": {
          "title": "Component Version",
          "type": "string"
        },
        "actor_type": {
          "enum": [
            "program",
            "model",
            "human"
          ],
          "title": "Actor Type",
          "type": "string"
        },
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        }
      },
      "required": [
        "component",
        "component_version",
        "actor_type",
        "actor_id"
      ],
      "title": "Producer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "validity": {
      "default": "current",
      "enum": [
        "current",
        "stale",
        "corrupt"
      ],
      "title": "Validity",
      "type": "string"
    },
    "workspace_id": {
      "title": "Workspace Id",
      "type": "string"
    },
    "paper_id": {
      "title": "Paper Id",
      "type": "string"
    },
    "paper_version_id": {
      "title": "Paper Version Id",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Run Id"
    },
    "verification_id": {
      "title": "Verification Id",
      "type": "string"
    },
    "finding_id": {
      "title": "Finding Id",
      "type": "string"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "input_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Input Evidence Ids",
      "type": "array"
    },
    "input_artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Input Artifact Ids",
      "type": "array"
    },
    "method": {
      "title": "Method",
      "type": "string"
    },
    "context_independence": {
      "enum": [
        "fresh",
        "inherited",
        "same_context",
        "human"
      ],
      "title": "Context Independence",
      "type": "string"
    },
    "blinded": {
      "title": "Blinded",
      "type": "boolean"
    },
    "supporting_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Supporting Evidence Ids",
      "type": "array"
    },
    "counterevidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Counterevidence Ids",
      "type": "array"
    },
    "result": {
      "enum": [
        "validated",
        "invalidated",
        "inconclusive"
      ],
      "title": "Result",
      "type": "string"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "record_id",
    "created_at",
    "producer",
    "workspace_id",
    "paper_id",
    "paper_version_id",
    "run_id",
    "verification_id",
    "finding_id",
    "question",
    "input_evidence_ids",
    "input_artifact_ids",
    "method",
    "context_independence",
    "blinded",
    "supporting_evidence_ids",
    "counterevidence_ids",
    "result",
    "rationale",
    "limitations"
  ],
  "title": "Verification",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}